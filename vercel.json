{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "client": {
            "root": "FSD Project/FSD Project/client",
            "framework": "vite"
        },
        "server": {
            "root": "FSD Project/FSD Project/server",
            "framework": "express"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "client"
            }
        }
    ]
}
